<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin | <%= siteName %></title><meta name="robots" content="noindex,nofollow"><link rel="stylesheet" href="/style.css"></head><body>
<header class="topbar"><a class="brand" href="/"><%= siteName %></a><a class="admin-link" href="/">View website ↗</a></header><main class="container admin-container"><p class="eyebrow">STORE MANAGEMENT</p><h1>Admin dashboard</h1><p class="muted">This page is password-protected. Visitor counts exclude known WhatsApp and social preview bots; unique visitors are approximate browser counts.</p>
<section class="stats-grid"><div class="stat"><span>Total page views</span><strong><%= stats.pageViews || 0 %></strong></div><div class="stat"><span>Unique browsers</span><strong><%= stats.uniqueVisitors || 0 %></strong></div><div class="stat"><span>Today's page views</span><strong><%= stats.todayViews || 0 %></strong></div><div class="stat"><span>Today's visitors</span><strong><%= stats.todayVisitors || 0 %></strong></div></section>
<div class="admin-columns"><section class="panel"><h2>Add a product</h2><form action="/admin/products" method="post" enctype="multipart/form-data" class="product-form"><label>Product name<input name="name" required maxlength="160" placeholder="e.g. Premium Watch"></label><label>Price in INR (optional)<input name="price" type="number" min="0" step="0.01" placeholder="1499"></label><label>Short description<textarea name="description" rows="4" maxlength="1000" placeholder="A short, helpful product description"></textarea></label><label>Product image (JPG, PNG, WEBP or GIF; max 5 MB)<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required></label><button class="button" type="submit">Add product</button></form></section>
<section class="panel"><h2>Top pages</h2><% if (!topPages.length) { %><p class="muted">No visits recorded yet.</p><% } else { %><ol class="rank-list"><% topPages.forEach(row => { %><li><span><%= row.path %></span><strong><%= row.views %></strong></li><% }) %></ol><% } %><h2 class="subheading">Most viewed products</h2><% if (!topProducts.length) { %><p class="muted">Add products to see product views.</p><% } else { %><ol class="rank-list"><% topProducts.forEach(row => { %><li><a href="/product/<%= encodeURIComponent(row.slug) %>"><%= row.name %></a><strong><%= row.views %></strong></li><% }) %></ol><% } %></section></div>
<section class="panel"><h2>Your products</h2><% if (!products.length) { %><p class="muted">No products yet.</p><% } else { %><div class="admin-products"><% products.forEach(product => { %><article class="admin-product"><img src="<%= product.image %>" alt=""><div class="admin-product-main"><strong><%= product.name %></strong><span class="muted"><%= product.price !== null ? money(product.price) : 'No price' %></span><a href="/product/<%= encodeURIComponent(product.slug) %>" target="_blank" rel="noopener">Open product page ↗</a><details><summary>Edit product</summary><form action="/admin/products/<%= product.id %>/update" method="post" enctype="multipart/form-data" class="product-form"><label>Name<input name="name" required value="<%= product.name %>"></label><label>Price in INR<input name="price" type="number" min="0" step="0.01" value="<%= product.price ?? '' %>"></label><label>Description<textarea name="description" rows="3"><%= product.description %></textarea></label><label>Replace image (optional)<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"></label><button class="button" type="submit">Save changes</button></form></details></div><form action="/admin/products/<%= product.id %>/delete" method="post" onsubmit="return confirm('Delete this product?')"><button class="button danger" type="submit">Delete</button></form></article><% }) %></div><% } %></section>
</main><footer>Admin dashboard · <a href="/">Return to catalog</a></footer></body></html>
